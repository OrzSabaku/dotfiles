{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "enabledManagers": ["mise"],
  "includePaths": ["home/.chezmoitemplates/common/config/mise/config.toml"],
  "automerge": false,
  "packageRules": [
    {
      "description": "Keep the initial trial limited to gh and chezmoi",
      "matchManagers": ["mise"],
      "enabled": false
    },
    {
      "matchManagers": ["mise"],
      "matchDepNames": ["gh", "chezmoi"],
      "enabled": true
    }
  ]
}
