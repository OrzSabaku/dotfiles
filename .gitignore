# Configuration is added explicitly to common/, omarchy/ or fedora/.
# Marksman uses the first matching rule; Git uses the last.
# Repeat document exceptions before /* so Marksman can index linked Markdown.
!/*.md
!/common/
!/omarchy/
!/fedora/
!/experiments/
!/docs/
/*
!/.gitignore
!/.gitmodules
!/submodules/
!/README.md
!/AGENTS.md
!/install.py
!/common/
!/omarchy/
!/fedora/
!/experiments/
!/scripts/
!/tests/
!/docs/
**/__pycache__/
*.py[cod]

# Machine-local Git identity, credentials and signature trust; never publish.
**/config.private
**/allowed_signers
**/.git-credentials
**/id_ed25519
**/id_rsa
