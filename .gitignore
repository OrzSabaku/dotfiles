# chezmoi source state lives in home/. Runtime files are never imported wholesale.
# Marksman uses the first matching rule; Git uses the last.
# Repeat document exceptions before /* so Marksman can index linked Markdown.
!/*.md
!/home/
!/examples/
!/experiments/
/*
!/.gitignore
!/.gitattributes
!/.gitmodules
!/.github/
!/Gemfile
!/Gemfile.lock
!/.rubocop.yml
!/.solargraph.yml
!/Rakefile
!/submodules/
!/README.md
!/AGENTS.md
!/.chezmoiroot
!/home/
!/examples/
!/experiments/
!/scripts/
!/tests/
**/__pycache__/
*.py[cod]

# Machine-local Git identity, credentials and signature trust; never publish.
**/config.private
**/allowed_signers
**/.git-credentials
**/id_ed25519
**/id_rsa

# chezmoi encodes dotfiles and permission attributes in source names.
**/private_config.private
**/private_allowed_signers
**/dot_git-credentials
**/private_dot_git-credentials
**/dot_ssh/**
home/dot_config/mozc/
home/dot_config/fcitx5/**
!home/dot_config/fcitx5/private_config
!home/dot_config/fcitx5/private_profile
!home/dot_config/fcitx5/conf/
!home/dot_config/fcitx5/conf/classicui.conf
!home/dot_config/fcitx5/conf/clipboard.conf
!home/dot_config/fcitx5/conf/pinyin.conf
!home/dot_config/fcitx5/conf/quickphrase.conf
!home/dot_config/fcitx5/conf/private_xcb.conf

# Mixed AI settings are updated by allowlisted modify templates only.
home/dot_codex/**
!home/dot_codex/AGENTS.md
!home/dot_codex/modify_private_config.toml
home/dot_config/private_amp/**
!home/dot_config/private_amp/modify_private_settings.json
home/dot_config/opencode/**
home/dot_pi/**
!home/dot_pi/agent/
!home/dot_pi/agent/modify_private_mcp.json
home/dot_config/private_gh/**
!home/dot_config/private_gh/private_config.yml
