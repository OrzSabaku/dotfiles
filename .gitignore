# Configuration is added explicitly to common/, omarchy/ or fedora/.
/*
!/.gitignore
!/.gitmodules
!/submodules/
!/README.md
!/AGENTS.md
!/install.py
!/common/
!/omarchy/
!/fedora/
!/experiments/
!/scripts/
!/tests/
**/__pycache__/
*.py[cod]

# Machine-local Git identity, credentials and signature trust; never publish.
**/config.private
**/allowed_signers
**/.git-credentials
**/id_ed25519
**/id_rsa
