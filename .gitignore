# Configuration is added explicitly to common/, omarchy/ or fedora/.
# Marksman uses the first matching rule; Git uses the last.
# Repeat document exceptions before /* so Marksman can index linked Markdown.
!/*.md
!/common/
!/omarchy/
!/fedora/
!/experiments/
/*
!/.gitignore
!/.gitmodules
!/Gemfile
!/Gemfile.lock
!/.rubocop.yml
!/.solargraph.yml
!/submodules/
!/README.md
!/AGENTS.md
!/install.py
!/common/
!/omarchy/
!/fedora/
!/experiments/
!/scripts/
!/tests/
**/__pycache__/
*.py[cod]

# Machine-local Git identity, credentials and signature trust; never publish.
**/config.private
**/allowed_signers
**/.git-credentials
**/id_ed25519
**/id_rsa

# Fcitx5: explicitly select preferences; keep runtime data and Mozc databases local.
**/.config/fcitx5/**
!**/.config/fcitx5/config
!**/.config/fcitx5/profile
!**/.config/fcitx5/conf/
!**/.config/fcitx5/conf/classicui.conf
!**/.config/fcitx5/conf/clipboard.conf
!**/.config/fcitx5/conf/pinyin.conf
!**/.config/fcitx5/conf/quickphrase.conf
!**/.config/fcitx5/conf/xcb.conf
**/.config/mozc/
**/.local/share/fcitx5/
