#!/usr/bin/env ruby
{{ include ".chezmoitemplates/shared/jsonc-preferences.rb" }}

preferences = JsoncPreferences.new($stdin.read)
preferences.set(["$schema"], "https://opencode.ai/config.json")
preferences.set(["theme"], "system")
preferences.set(["autoupdate"], false)
preferences.set(["mcp", "atuin", "type"], "local")
preferences.set(["mcp", "atuin", "command"], [File.join({{ .chezmoi.homeDir | quote }}, ".atuin/bin/atuin"), "mcp"])
preferences.set(["mcp", "atuin", "enabled"], true)
$stdout.write(preferences.to_s)
