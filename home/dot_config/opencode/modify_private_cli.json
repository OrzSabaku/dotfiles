{{- /* chezmoi:modify-template */ -}}
{{- /* 設定項目だけを更新し、認証情報・信頼設定・生成された連携情報は保持する。 */ -}}
{{- $original := (.chezmoi.stdin | default "{}" | fromJsonc) -}}
{{- $config := deepCopy $original -}}
{{- $config = setValueAtPath (list "theme" "name") "system" $config -}}
{{- if eq ($config | toJson) ($original | toJson) -}}
{{ .chezmoi.stdin }}
{{- else -}}
{{ $config | toPrettyJson }}
{{- end -}}
