    "editor.fontFamily": "'cascadia code', 'Fira Code', 'Courier New', monospace",
    "editor.fontLigatures": "'calt', 'ss01', 'ss02', 'ss03', 'ss04', 'ss05', 'ss06', 'zero', 'cv02'",
    // g r => <> <= >= |=
    "editor.linkedEditing": true,
