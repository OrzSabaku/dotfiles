{{- /* chezmoi:modify-template */ -}}
{{- /* 設定項目だけを更新し、認証情報・信頼設定・生成された連携情報は保持する。 */ -}}
{{- $original := (.chezmoi.stdin | default "{}" | fromJson) -}}
{{- $config := deepCopy $original -}}
{{- $config = setValueAtPath (list "openH264Enabled") true $config -}}
{{- $config = setValueAtPath (list "BACKGROUND_COLOR") "#121214" $config -}}
{{- $config = setValueAtPath (list "offloadAdmControls") true $config -}}
{{- if eq ($config | toJson) ($original | toJson) -}}
{{ .chezmoi.stdin }}
{{- else -}}
{{ $config | toPrettyJson }}
{{- end -}}
