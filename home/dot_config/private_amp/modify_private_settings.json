{{- /* chezmoi:modify-template */ -}}
{{- /* 設定項目だけを更新し，認証情報・信頼設定・生成された連携情報は保持する． */ -}}
{{- $original := (.chezmoi.stdin | default "{}" | fromJson) -}}
{{- $config := deepCopy $original -}}
{{- $config = setValueAtPath (list "amp.mcpServers" "atuin" "command") (joinPath .chezmoi.homeDir ".atuin/bin/atuin") $config -}}
{{- $config = setValueAtPath (list "amp.mcpServers" "atuin" "args") ("[\"mcp\"]" | fromJson) $config -}}
{{- if eq ($config | toJson) ($original | toJson) -}}
{{ .chezmoi.stdin }}
{{- else -}}
{{ $config | toPrettyJson }}
{{- end -}}
