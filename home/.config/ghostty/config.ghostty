font-family = JetBrains Mono
theme = TokyoNight Night

font-size = 14
background-opacity = 0.84
window-padding-x = 12
window-padding-y = 10
scrollback-limit = 10000
shell-integration = detect
background-blur-radius = 20
cursor-style = block
cursor-style-blink = true
selection-background = #45475a
scrollback-limit = 10000
window-save-state = always
confirm-close-surface = false

custom-shader = ~/.config/ghostty/shaders/cursor-shaders/ghostty/cursor_warp.glsl
custom-shader = /home/kanazawa/.config/ghostty/shaders/ghostty-shaders2/shaders/my_raindrop_neo2_continuous.glsl
custom-shader-animation = true

keybind = ctrl+shift+w=close_surface
keybind = ctrl+shift+r=new_split:right
keybind = ctrl+shift+l=new_split:left
keybind = ctrl+shift+t=new_tab
# keybind = ctrl+shift+d=new_split:down
# keybind = ctrl+d=new_split:right
keybind = ctrl+shift+left=goto_split:left
keybind = ctrl+shift+right=goto_split:right
# keybind = ctrl+up=goto_split:top
# keybind = ctrl+down=goto_split:bottom
# 〜デフォであったわ〜
# keybind = ctrl+equal=increase_font_size
# keybind = ctrl+minus=decrease_font_size
# keybind = ctrl+shift+0=reset_font_size
